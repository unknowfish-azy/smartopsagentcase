{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartops.local/schemas/training/smartops-training-sample-v1.json",
  "title": "SmartOpsAgent unified training sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "dataset_id",
    "dataset_version",
    "schema_version",
    "dataset_type",
    "task_type",
    "instruction",
    "environment",
    "knowledge",
    "evidence",
    "agent_context",
    "policy",
    "expected_behavior",
    "output",
    "verification",
    "inspector",
    "source",
    "quality",
    "metadata"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "dataset_id": {"type": "string", "minLength": 1, "pattern": "^smartops-[a-z0-9-]+$"},
    "dataset_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "schema_version": {"const": "1.0.0"},
    "dataset_type": {
      "enum": ["SFT", "PREFERENCE", "EVIDENCE", "INSPECTOR", "TOOL_SELECTION", "RISK", "APPROVAL", "SAFETY", "VERIFICATION", "SYNTHETIC_INCIDENT"]
    },
    "task_type": {
      "enum": ["OPS_REASONING", "EVIDENCE_VERIFICATION", "TOOL_SELECTION", "RISK_DECISION", "APPROVAL_DECISION", "SAFETY_REVIEW", "RESULT_VERIFICATION", "INSPECTION", "INCIDENT_SCENARIO", "PREFERENCE_RANKING"]
    },
    "instruction": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/environment"},
    "knowledge": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "agent_context": {"type": "object"},
    "policy": {"type": "object"},
    "expected_behavior": {"type": "object"},
    "output": {"type": "object"},
    "verification": {"type": "object"},
    "inspector": {"type": "object"},
    "source": {"$ref": "#/$defs/source"},
    "quality": {"$ref": "#/$defs/quality"},
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "allOf": [
    {
      "if": {"properties": {"task_type": {"const": "OPS_REASONING"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/opsOutput"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "EVIDENCE_VERIFICATION"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/evidenceOutput"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "TOOL_SELECTION"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/toolOutput"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "RISK_DECISION"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/riskOutput"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "INSPECTION"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/inspectorOutput"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "RESULT_VERIFICATION"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/verificationOutput"}}}
    },
    {
      "if": {"properties": {"dataset_type": {"const": "PREFERENCE"}}},
      "then": {"properties": {"expected_behavior": {"$ref": "#/$defs/preference"}}}
    },
    {
      "if": {"properties": {"task_type": {"const": "PREFERENCE_RANKING"}}},
      "then": {"properties": {"output": {"$ref": "#/$defs/preference"}}}
    }
  ],
  "$defs": {
    "environment": {
      "type": "object",
      "minProperties": 1,
      "required": ["environment_id", "observed_at"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "os": {"type": "string"},
        "services": {"type": "object"},
        "resources": {"type": "object"}
      },
      "additionalProperties": true
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "source", "version", "service", "trust", "content"],
      "properties": {
        "knowledge_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "created_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "service": {"type": "string", "minLength": 1},
        "environment": {"type": "object"},
        "trust": {"type": "number", "minimum": 0, "maximum": 1},
        "content": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source", "content", "timestamp", "relevance", "version"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "version": {"type": "string", "minLength": 1},
        "support_relation": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONTRADICTED", "UNKNOWN"]},
        "metadata": {"type": "object"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "created_at", "data_class"],
      "properties": {
        "source_type": {"enum": ["OFFICIAL_DOCUMENTATION", "EXISTING_KNOWLEDGE", "REAL_LOG", "REAL_AGENT_TRACE", "SYNTHETIC_INCIDENT", "HUMAN_REVIEWED"]},
        "source_ref": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "data_class": {"enum": ["REAL", "SYNTHETIC", "DEMO"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "human_review", "checks"],
      "properties": {
        "status": {"enum": ["PENDING", "PASSED", "REJECTED"]},
        "human_review": {"enum": ["NOT_REVIEWED", "SAMPLED", "APPROVED", "REJECTED"]},
        "checks": {"type": "object"},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["incident_family", "root_cause_group", "scenario_id"],
      "properties": {
        "incident_family": {"type": "string", "minLength": 1},
        "root_cause_group": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "opsOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis", "root_cause", "evidence", "confidence", "reasoning_summary", "plan", "next_tool", "risk", "approval_required", "verification_plan"],
      "properties": {
        "diagnosis": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reasoning_summary": {"type": "string", "minLength": 1},
        "plan": {"type": "array", "items": {"type": "string"}},
        "next_tool": {"type": ["string", "null"]},
        "risk": {"$ref": "#/$defs/risk"},
        "approval_required": {"type": "boolean"},
        "verification_plan": {"type": "array", "items": {"type": "string"}},
        "decision": {"enum": ["PROCEED", "REJECT", "WAIT_APPROVAL", "HUMAN_REVIEW_REQUIRED"]}
      }
    },
    "evidenceOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reason", "supporting_evidence", "confidence"],
      "properties": {
        "label": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONTRADICTED"]},
        "reason": {"type": "string", "minLength": 1},
        "supporting_evidence": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "toolOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "tool", "reason", "risk", "approval_required"],
      "properties": {
        "decision": {"enum": ["SELECT", "REJECT", "HUMAN_REVIEW_REQUIRED"]},
        "tool": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "risk": {"$ref": "#/$defs/risk"},
        "approval_required": {"type": "boolean"}
      }
    },
    "riskOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "reason", "approval_required"],
      "properties": {
        "risk": {"$ref": "#/$defs/risk"},
        "reason": {"type": "string", "minLength": 1},
        "approval_required": {"type": "boolean"}
      }
    },
    "verificationOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "replan_required"],
      "properties": {
        "status": {"enum": ["SUCCESS", "FALSE_SUCCESS", "FAILED", "UNKNOWN"]},
        "reason": {"type": "string", "minLength": 1},
        "replan_required": {"type": "boolean"}
      }
    },
    "inspectorOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "category", "severity", "issues", "reason", "recommendation", "requires_human"],
      "properties": {
        "decision": {"enum": ["PASS", "WARNING", "VIOLATION", "BLOCK", "HUMAN_REVIEW_REQUIRED"]},
        "category": {"enum": ["PLANNING", "EVIDENCE", "TOOL", "RISK", "PERMISSION", "APPROVAL", "VERIFICATION", "KNOWLEDGE", "MODEL", "SECURITY", "PERFORMANCE", "LOOP", "HALLUCINATION", "VERSION"]},
        "severity": {"enum": ["INFO", "WARNING", "HIGH", "CRITICAL"]},
        "issues": {"type": "array", "items": {"type": "object"}},
        "reason": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "requires_human": {"type": "boolean"}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "rejected", "reason", "principles"],
      "properties": {
        "chosen": {"type": "object"},
        "rejected": {"type": "object"},
        "reason": {"type": "string", "minLength": 1},
        "principles": {"type": "array", "minItems": 1, "items": {"enum": ["EVIDENCE_FIRST", "READ_ONLY_FIRST", "RISK_CONTROLLED", "VERSION_AWARE", "ENVIRONMENT_AWARE", "VERIFICATION_REQUIRED", "AUDITABLE"]}}
      }
    }
  }
}
