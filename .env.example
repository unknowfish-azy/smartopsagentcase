# ============================================================
# SmartOpsAgent 环境变量示例配置
# ------------------------------------------------------------
# 使用方法：
#   【新手推荐】直接运行 scripts/handoff-kit/2-安装环境.bat，
#   它会自动从本模板生成 .env 并随机生成所有安全密钥，无需手动填写。
#
#   【手动方式】
#   1. 复制本文件为 .env  ：  copy .env.example .env
#   2. 必须填入以下安全字段（留空会导致服务拒绝启动，fail-closed）：
#        SMARTOPS_CHAT_RUN_TOKEN_SECRET   聊天令牌共享密钥（≥16 字节）
#        SMARTOPS_INTERNAL_TOKEN          内部服务鉴权 token
#        KNOWLEDGE_API_KEY                知识服务 API Key
#        SMARTOPS_API_KEY_ENCRYPTION_KEY  Base64 编码的 32 字节 AES 密钥
#        MYSQL_PASSWORD                   MySQL 密码
#        SMARTOPS_BOOTSTRAP_PASSWORD      首个管理员引导口令（≥16，生产必填；
#                                         留空则不创建管理员）
#   3. 连接中心收口（批次一 #3）：生产还需配置
#        SMARTOPS_SSH_ALLOWED_TARGETS    目标白名单（逗号分隔 主机/CIDR[:端口]）
#        SMARTOPS_SSH_IDENTITY_ROOT      私钥受控目录（留空=禁用私钥认证）
#   4. 模型网关限流（批次一 #28）可选：SMARTOPS_GATEWAY_RATE_LIMIT_RPM（默认 60）
#   5. 启动脚本（start-platform.ps1 / handoff-kit 等）会自动加载根 .env
# ============================================================

# ============================================================
# 1. 应用基础信息（AI Service）
# ============================================================
# AI 服务监听地址
HOST=0.0.0.0
# AI 服务监听端口
PORT=8001
# 是否开启调试模式（true / false）
DEBUG=false
# 应用名称
APP_NAME=SmartOpsAgent AI Service
# 应用版本号
APP_VERSION=0.1.0

# ============================================================
# 2. LLM 模型服务（AI Service 核心配置）
# ============================================================
# LLM Provider：mock / ollama / openai-compatible
# 默认 mock，无需任何密钥即可跑通流程
LLM_PROVIDER=mock
# 使用的模型名称
LLM_MODEL=mock-model
# 模型服务地址（Ollama / OpenAI 兼容接口）
LLM_BASE_URL=http://localhost:11434
# KV-CACHE：Ollama 上下文窗口（options.num_ctx）。0=沿用服务端默认；
# 实测默认窗口下大 prompt 会挤掉 KV 缓存使前缀复用失效，RAG 场景建议 8192
LLM_NUM_CTX=0
# KV-CACHE：Ollama KV 心跳保活——空闲期每 interval 秒发超短请求，
# 重置 Ollama 内部的 KV 驱逐计时窗口。仅 LLM_PROVIDER=ollama 时启用。
# 默认关闭：实测心跳无法维持完整前缀复用，反而持续占用 CPU/显存。
OLLAMA_HEARTBEAT_ENABLED=false
# 心跳间隔（秒）。默认 45——远小于 LLM_KEEP_ALIVE_SEC(300)
OLLAMA_HEARTBEAT_INTERVAL_SEC=45
# 单次心跳超时（秒）。心跳必须快，超时就等下一轮
OLLAMA_HEARTBEAT_TIMEOUT_SEC=5.0
# KV-CACHE：RAG 检索缓存 TTL（秒）。默认 60 过短——过期后重检索证据漂移，
# 导致 prompt 证据段不再逐字节一致、KV 前缀复用失效；演示场景建议 900
RAG_CACHE_TTL_SEC=60
# KV-CACHE：模型与 KV 缓存驻留时长（秒）。默认 300——空闲 5 分钟即卸载，
# 释放 1.5-3GB 显存（8GB 显卡建议保持）；显存充裕（≥16GB）可调回 1800
LLM_KEEP_ALIVE_SEC=300
# Local model calls bypass environment proxies; preserve this for other local clients.
NO_PROXY=127.0.0.1,localhost
# 模型服务 API Key（外部模型鉴权密钥，留空即可走 mock）
LLM_API_KEY=
# 调用模型服务的超时时间（秒）
REQUEST_TIMEOUT=30

# ------------------------------------------------------------
# 大模型接入示例（ReAct 智能体大脑，阶段 0）
# 把上面 LLM_PROVIDER 改为 openai-compatible，再按下表填 base_url/model/api_key 即可。
# base_url 必须含 OpenAI 兼容路径（通常以 /v1 结尾，Provider 会拼 /chat/completions）。
#
#   Kimi(Moonshot)： LLM_BASE_URL=https://api.moonshot.cn/v1            LLM_MODEL=kimi-k2
#   DeepSeek：      LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
#   OpenAI：        LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o
#   Qwen(DashScope)：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#
# 示例（接入 Kimi 时取消注释并填真实密钥）：
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2
# LLM_API_KEY=sk-你的真实密钥
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.2
# 可选：主模型故障时自动降级到 mock，保证链路永远有产出
# LLM_FALLBACK_PROVIDER=mock
#
# 本地小模型（Ollama，无需真实密钥）：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:1.7b

# ============================================================
# 3. Knowledge 服务（RAG 检索编排）
# ============================================================
# Knowledge Service 地址（AI Service 通过 HTTP 调用）
KNOWLEDGE_SERVICE_URL=http://localhost:8002
# Knowledge 服务 API Key（生产必填；留空且未允许匿名时服务拒绝启动）
KNOWLEDGE_API_KEY=
# 未配置 API Key 时允许匿名访问（默认 false；开启后仅回环客户端可用）
KNOWLEDGE_ALLOW_ANONYMOUS=false
# 兼容保留：摄入永不接受匿名（即使设为 1 也不放行，必须配置 API Key）
KNOWLEDGE_ALLOW_INGEST=0
# 嵌入模型跑在哪：默认 cpu（bge-small 单条编码仅几十毫秒，把显存留给 Ollama）；
# 填 auto 表示有 CUDA 就用 cuda:0，也可显式填 cuda / cuda:0 / cpu
# KNOWLEDGE_EMBEDDING_DEVICE=cpu
# AI Service 对外访问地址（供其它服务调用）
AI_SERVICE_URL=http://localhost:8001

# ---- 对话记忆闭环（AI Service → Backend /api/internal/memory/*）----
# 总开关：关闭后不召回已沉淀经验，也不回写用户教给的规则
MEMORY_ENABLED=true
# Backend 地址（AI Service 不直连数据库，读写记忆走内部接口）
MEMORY_SERVICE_URL=http://localhost:8080
# 必须与 Backend 的 SMARTOPS_INTERNAL_TOKEN 一致；留空时记忆链路自动降级（不读不写）
MEMORY_INTERNAL_TOKEN=
# 单轮最多注入几条历史记忆（Backend 侧上限 20）
MEMORY_RECALL_LIMIT=3
# 内部接口超时（秒）：记忆是增强项，不能拖慢首 token
MEMORY_TIMEOUT_SEC=2.0

# ============================================================
# 4. MySQL（Backend 数据源 / docker compose）
# ============================================================
# SEC-13：compose 不再提供默认口令，MYSQL_ROOT_PASSWORD 与 MYSQL_PASSWORD 必填
# MySQL root 初始化口令（仅 compose 首次建库使用）
MYSQL_ROOT_PASSWORD=
# 生产 MySQL JDBC URL（含时区/编码参数）
MYSQL_URL=jdbc:mysql://localhost:3306/smartops?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# MySQL 用户名
MYSQL_USERNAME=root
# MySQL 密码（生产必填，空值/已知弱口令会被启动断言拒绝）
MYSQL_PASSWORD=

# ============================================================
# 5. Redis（缓存 / 任务状态）
# ============================================================
# Redis 主机
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 数据库编号
REDIS_DATABASE=0
# Redis 密码（SEC-13：compose 强制 requirepass，生产必填）
REDIS_PASSWORD=

# ============================================================
# 6. Backend 服务
# ============================================================
# Spring Boot 服务端口
SERVER_PORT=8080

# ============================================================
# 7. Ollama（本地模型服务，可选）
# ============================================================
# Ollama 基础地址
OLLAMA_BASE_URL=http://localhost:11434
# ----------------------------------------------------------------
# Ollama 服务端环境变量（**在启动 Ollama 服务前设置**，不是 AI Service 的配置）
# 做法：在启动 Ollama 的 shell/终端里先 export，再 ollama serve
#   Windows PowerShell: $env:OLLAMA_KV_CACHE_TYPE='q8_0'; ollama serve
#   Linux/macOS:        OLLAMA_KV_CACHE_TYPE=q8_0 ollama serve
# ----------------------------------------------------------------
# KV 缓存量化——省一半显存，同等显存下窗口更大、缓存更不容易被挤
# 可选值: f16(默认), q8_0(推荐), q4_0(更省但有损)
# OLLAMA_KV_CACHE_TYPE=q8_0
# Flash Attention——加速预填充/解码，配合 q8_0 效果更佳
# OLLAMA_FLASH_ATTENTION=1
# 最大并发请求（默认 1，本机演示保持 1 即可）
# OLLAMA_NUM_PARALLEL=1

# ============================================================
# 7.5 TTS 本地神经语音（桌宠「小鱼」播报，可选）
# ------------------------------------------------------------
# 未安装/未配置时 /api/tts/synthesize 返回 503 并写明原因，
# 前端自动回落浏览器 speechSynthesis（绝不出假音频）。
# Provider：auto（f5tts → edge → baidu → voxcpm2 → piperplus 取第一个可用）
# 也可强制 f5tts / edge / baidu / voxcpm2 / piperplus；none = 关闭（前端回落浏览器语音）
TTS_PROVIDER=auto
# 甜度档位（仅 edge provider 生效，可覆盖内置默认值）：
# 音高上抬 Hz（18 ≈ 两个半音，少女感的主要来源）与语速偏移百分比（10 = 快 10%）
TTS_EDGE_VOICE=zh-CN-XiaoyiNeural
TTS_EDGE_PITCH_HZ=18
TTS_EDGE_RATE_PERCENT=10
# 可选情感风格（mstts:express-as，如 cheerful / affectionate）；
# 留空=不启用——并非所有音色都支持，强加会导致整条 SSML 被拒
TTS_EDGE_STYLE=
# 推理设备：auto（有 CUDA 用 GPU）/ cuda / cpu
TTS_DEVICE=auto
# 单次合成文本上限（字符），超长直接 400
TTS_MAX_CHARS=300
# 单次合成超时（秒），首次含权重加载
TTS_TIMEOUT_SEC=120
# VoxCPM2 权重：本地目录或 HuggingFace 仓库 id（留空=不可用）
TTS_VOXCPM_MODEL_DIR=
# F5-TTS 权重目录（留空=用包内置默认权重，首次运行联网下载）
TTS_F5_MODEL_DIR=
# F5-TTS 的 vocos 声码器目录（需含 config.yaml 与 pytorch_model.bin）；
# 留空=首次合成时从 HF 下载 charactr/vocos-mel-24khz（国内直连常超时）
TTS_F5_VOCODER_DIR=
# F5-TTS 前置条件：torchaudio 2.9+ 用 torchcodec 解码，需要 **share 版 FFmpeg**
# 的 avcodec 等 DLL 在 PATH 里（静态版 ffmpeg.exe 不够），否则合成时报
# "Could not load libtorchcodec"。Windows 可把 ffmpeg-*-shared/bin 加进 PATH。
# 更省事的做法：直接在这里填共享库 bin 目录，服务启动后导入 f5_tts 前会调用
# os.add_dll_directory 并前置到 PATH（留空=不注册，沿用系统 PATH）。
# 例：TTS_FFMPEG_SHARED_DIR=E:\ffmpeg-shared\ffmpeg-9.0.2-full_build-shared\bin
TTS_FFMPEG_SHARED_DIR=
# Piper-Plus 模型 .onnx（本地 CPU 推理，可回传音素级时间戳 → 真口型）。
# 必须用 piper-plus 自家 release 的 multilingual 模型（上游 rhasspy 中文模型是
# espeak 音素类型，piper-plus 2.x 无法加载）；留空=该 Provider 不可用。
# 安装：pip install "piper-plus[cpu]==2.0.2"
TTS_PIPER_MODEL=
# Piper-Plus 模型配置 json；留空=自动找 <model>.json 或同目录 config.json
TTS_PIPER_CONFIG=
# 音色预设（JSON）：音色名 → {audio, text, description}；
# audio 为参考音频（相对路径按仓库根解析），text 是该音频的转写文本。
# 甜妹少女音示例：TTS_VOICE_PRESETS={"sweet_girl":{"audio":"assets/tts/sweet_girl.wav","text":"参考音频的原文","description":"甜妹少女音"}}
TTS_VOICE_PRESETS={}

# ============================================================
# 8. Frontend 前端
# ============================================================
# 前端 API 基础地址（Vite 构建时注入）
VITE_API_BASE_URL=http://localhost:8080

# ============================================================
# 9. 测试环境配置（tests/ 目录 pytest 使用）
# ============================================================
# Backend 测试地址
# Zhipu Vision MCP (local image analysis only; never commit a real key)
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4v-plus

SMARTOPS_BACKEND_URL=http://127.0.0.1:8080
# 机器人域子智能体访问后端：Bearer 令牌优先；没有令牌时用服务账号自动登录
# （账号需具备 robot 读权限，密码只放本地 .env，不要提交）
SMARTOPS_AGENT_TOKEN=
SMARTOPS_AGENT_USERNAME=
SMARTOPS_AGENT_PASSWORD=
# AI Service 测试地址
SMARTOPS_AI_SERVICE_URL=http://127.0.0.1:8001
# Knowledge Service 测试地址
SMARTOPS_KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8002

# MySQL 集成测试配置
SMARTOPS_MYSQL_HOST=127.0.0.1
SMARTOPS_MYSQL_PORT=3306
SMARTOPS_MYSQL_USER=root
SMARTOPS_MYSQL_PASSWORD=
SMARTOPS_MYSQL_DATABASE=smartops

# Redis 集成测试配置
SMARTOPS_REDIS_HOST=127.0.0.1
SMARTOPS_REDIS_PORT=6379
SMARTOPS_REDIS_DB=0

# E2E 登录测试账号（未设置时该用例自动 skip）
SMARTOPS_LOGIN_PATH=/api/auth/login
SMARTOPS_TEST_USERNAME=
SMARTOPS_TEST_PASSWORD=

# E2E Agent 任务测试
SMARTOPS_AGENT_URL=
SMARTOPS_AGENT_TASK_PATH=/api/agent/tasks
# ============================================================
# SmartOps Model Security
# ============================================================

# Base64 encoded 32-byte AES key.
# Production 必须替换。
SMARTOPS_API_KEY_ENCRYPTION_KEY=

# Internal service authentication.
SMARTOPS_INTERNAL_TOKEN=
# 仅限显式本地调试；生产必须保持 false
SMARTOPS_INTERNAL_BYPASS=false
# 生产标记（也可用 spring profile prod/production 触发）。
# 生产下 internal-bypass=true、内部 token 缺失/过短、聊天令牌机密缺失都会拒绝启动。
SMARTOPS_SECURITY_PRODUCTION=false

# Chat run token (SEC-01/SEC-02)
# Java 签发 / ai-service 校验的共享密钥，至少 16 字节；两侧必须一致。
SMARTOPS_CHAT_RUN_TOKEN_SECRET=
SMARTOPS_CHAT_RUN_TOKEN_TTL_SECONDS=300
CHAT_RUN_TOKEN_SECRET=
# 仅本地/内网联调可设 true；生产必须 false（否则等同放弃聊天鉴权）。
CHAT_ALLOW_ANONYMOUS=false

# 首次创建管理员（在接收方本机设置强密码）
SMARTOPS_BOOTSTRAP_USERNAME=admin
# 生产必填：首个管理员引导口令（≥16 字符，且不得等于已知默认值）；
# 留空则不创建首个管理员（fail-closed），且首次登录强制改密。
SMARTOPS_BOOTSTRAP_PASSWORD=

# SSH 连接中心目标收口（批次一 #3）：逗号分隔主机/CIDR[:port]，生产必填
SMARTOPS_SSH_ALLOWED_TARGETS=
# 私钥受控目录（留空则生产禁止 identityPath 私钥认证）
SMARTOPS_SSH_IDENTITY_ROOT=
# 模型网关每 key 每分钟调用上限（批次一 #28），0 关闭（不推荐）
SMARTOPS_GATEWAY_RATE_LIMIT_RPM=60

# 模型运行时地址：Java Mini、视觉巡检与 Python Agent 共用这一处（换底座只改这里）
SMARTOPS_MODEL_LOCAL_BASE_URL=http://127.0.0.1:11434
SMARTOPS_MODEL_LOCAL_TIMEOUT_SECONDS=120
# 模型网关控制面：生效配置热加载间隔（毫秒）
SMARTOPS_MODEL_CONTROL_PLANE_REFRESH_MS=15000
# 模型网关配置发布所需的审批级数：0=直接发布，>0=需他人审批（创建人不能审批自己的版本）
SMARTOPS_MODEL_CONTROL_PLANE_REQUIRED_APPROVALS=0
# 模型网关配置审批人用户名白名单（逗号分隔）：留空=任意管理员可审批
SMARTOPS_MODEL_CONTROL_PLANE_APPROVERS=
# 各用途的本地模型名（需与模型运行时中已安装的名称一致）
SMARTOPS_MINI_MODEL=qwen3:1.7b
SMARTOPS_VISION_MODEL=qwen2.5vl:3b

# ============================================================
# 10. 桌面手（Desktop Hand）——智能运维的 UI 兜底通道
# ------------------------------------------------------------
# ARCHITECTURE §4：UI 是兜底，默认关。
# 两条都支持：DESKTOP_HAND_*（设计文档写的）优先，没设再查 SMARTOPS_DESKTOP_HAND_*（项目惯例）。
DESKTOP_HAND_ENABLED=false
# 输入组（click/type/key）默认关；true 时 click/type/key 放行，observe 始终可用
DESKTOP_HAND_INPUT_GROUP=false
# 急停热键（默认 ctrl+alt+shift+f12），触发后所有 desktop 动作立即锁定
DESKTOP_HAND_EMERGENCY_HOTKEY=ctrl+alt+shift+f12
# 远程 driver（模式二：agent 在阿里云，被控端 ssh -R 映射到云端 loopback）。
# 只允许 http://127.0.0.1:<port> / localhost / ::1；云端端口 = 19200 + machine_index。
# 留空则走本机 WindowsDriver（模式一）。token 必须与被控端 driver_service 一致。
# DESKTOP_HAND_DRIVER_URL=http://127.0.0.1:19222
# DESKTOP_HAND_DRIVER_TOKEN=change-me-per-machine
# 也可用 SMARTOPS_ 前缀：
# SMARTOPS_DESKTOP_HAND_ENABLED=false
# SMARTOPS_DESKTOP_HAND_INPUT_GROUP=false
# SMARTOPS_DESKTOP_HAND_DRIVER_URL=http://127.0.0.1:19222
# SMARTOPS_DESKTOP_HAND_DRIVER_TOKEN=change-me-per-machine
