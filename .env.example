# ============================================================
# SmartOpsAgent 环境变量示例配置
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env  ：  copy .env.example .env
#   2. 按需填入真实密钥 / 地址（示例中的密钥全部留空）
#   3. 按 docs/HANDOFF-STARTUP.md 将 .env 加载到当前进程后再启动服务
#      start-dev.ps1 不自动加载根 .env；AI Service 的 .env 路径相对于工作目录
# ============================================================

# ============================================================
# 1. 应用基础信息（AI Service）
# ============================================================
# AI 服务监听地址
HOST=0.0.0.0
# AI 服务监听端口
PORT=8001
# 是否开启调试模式（true / false）
DEBUG=false
# 应用名称
APP_NAME=SmartOpsAgent AI Service
# 应用版本号
APP_VERSION=0.1.0

# ============================================================
# 2. LLM 模型服务（AI Service 核心配置）
# ============================================================
# LLM Provider：mock / ollama / openai-compatible
# 默认 mock，无需任何密钥即可跑通流程
LLM_PROVIDER=mock
# 使用的模型名称
LLM_MODEL=mock-model
# 模型服务地址（Ollama / OpenAI 兼容接口）
LLM_BASE_URL=http://localhost:11434
# Local model calls bypass environment proxies; preserve this for other local clients.
NO_PROXY=127.0.0.1,localhost
# 模型服务 API Key（外部模型鉴权密钥，留空即可走 mock）
LLM_API_KEY=
# 调用模型服务的超时时间（秒）
REQUEST_TIMEOUT=30

# ============================================================
# 3. Knowledge 服务（RAG 检索编排）
# ============================================================
# Knowledge Service 地址（AI Service 通过 HTTP 调用）
KNOWLEDGE_SERVICE_URL=http://localhost:8002
# Knowledge 服务 API Key（生产必填；留空且未允许匿名时服务拒绝启动）
KNOWLEDGE_API_KEY=
# 未配置 API Key 时允许匿名访问（默认 false；开启后仅回环客户端可用）
KNOWLEDGE_ALLOW_ANONYMOUS=false
# 兼容保留：摄入永不接受匿名（即使设为 1 也不放行，必须配置 API Key）
KNOWLEDGE_ALLOW_INGEST=0
# AI Service 对外访问地址（供其它服务调用）
AI_SERVICE_URL=http://localhost:8001

# ============================================================
# 4. MySQL（Backend 数据源）
# ============================================================
# 生产 MySQL JDBC URL（含时区/编码参数）
MYSQL_URL=jdbc:mysql://localhost:3306/smartops?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# MySQL 用户名
MYSQL_USERNAME=root
# MySQL 密码（实际密钥留空）
MYSQL_PASSWORD=

# ============================================================
# 5. Redis（缓存 / 任务状态）
# ============================================================
# Redis 主机
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 数据库编号
REDIS_DATABASE=0
# Redis 密码（本地无密码时留空）
REDIS_PASSWORD=

# ============================================================
# 6. Backend 服务
# ============================================================
# Spring Boot 服务端口
SERVER_PORT=8080

# ============================================================
# 7. Ollama（本地模型服务，可选）
# ============================================================
# Ollama 基础地址
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# 8. Frontend 前端
# ============================================================
# 前端 API 基础地址（Vite 构建时注入）
VITE_API_BASE_URL=http://localhost:8080

# ============================================================
# 9. 测试环境配置（tests/ 目录 pytest 使用）
# ============================================================
# Backend 测试地址
# Zhipu Vision MCP (local image analysis only; never commit a real key)
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4v-plus

SMARTOPS_BACKEND_URL=http://127.0.0.1:8080
# AI Service 测试地址
SMARTOPS_AI_SERVICE_URL=http://127.0.0.1:8001
# Knowledge Service 测试地址
SMARTOPS_KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8002

# MySQL 集成测试配置
SMARTOPS_MYSQL_HOST=127.0.0.1
SMARTOPS_MYSQL_PORT=3306
SMARTOPS_MYSQL_USER=root
SMARTOPS_MYSQL_PASSWORD=
SMARTOPS_MYSQL_DATABASE=smartops

# Redis 集成测试配置
SMARTOPS_REDIS_HOST=127.0.0.1
SMARTOPS_REDIS_PORT=6379
SMARTOPS_REDIS_DB=0

# E2E 登录测试账号（未设置时该用例自动 skip）
SMARTOPS_LOGIN_PATH=/api/auth/login
SMARTOPS_TEST_USERNAME=
SMARTOPS_TEST_PASSWORD=

# E2E Agent 任务测试
SMARTOPS_AGENT_URL=
SMARTOPS_AGENT_TASK_PATH=/api/agent/tasks
# ============================================================
# SmartOps Model Security
# ============================================================

# Base64 encoded 32-byte AES key.
# Production 必须替换。
SMARTOPS_API_KEY_ENCRYPTION_KEY=

# Internal service authentication.
SMARTOPS_INTERNAL_TOKEN=
# 仅限显式本地调试；生产必须保持 false
SMARTOPS_INTERNAL_BYPASS=false
# 生产标记（也可用 spring profile prod/production 触发）。
# 生产下 internal-bypass=true、内部 token 缺失/过短、聊天令牌机密缺失都会拒绝启动。
SMARTOPS_SECURITY_PRODUCTION=false

# Chat run token (SEC-01/SEC-02)
# Java 签发 / ai-service 校验的共享密钥，至少 16 字节；两侧必须一致。
SMARTOPS_CHAT_RUN_TOKEN_SECRET=
SMARTOPS_CHAT_RUN_TOKEN_TTL_SECONDS=300
CHAT_RUN_TOKEN_SECRET=
# 仅本地/内网联调可设 true；生产必须 false（否则等同放弃聊天鉴权）。
CHAT_ALLOW_ANONYMOUS=false

# 首次创建管理员（在接收方本机设置强密码）
SMARTOPS_BOOTSTRAP_USERNAME=admin
SMARTOPS_BOOTSTRAP_PASSWORD=

# Java 后端 Mini 独立于 Python LLM_PROVIDER
SMARTOPS_MINI_BASE_URL=http://127.0.0.1:11434
SMARTOPS_MINI_MODEL=qwen3:1.7b
