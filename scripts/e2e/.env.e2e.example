# E2E 夹具凭据模板 —— 复制为同目录 .env.e2e 后填入本地实际值。
# .env.e2e 已被 .gitignore 的 `.env.*` 规则排除，不会进入版本库。
#
#   copy .env.e2e.example .env.e2e    （Windows: Copy-Item .env.e2e.example .env.e2e）
#
# 各套件共享同一组夹具账号，口令必须与 seed_sec_fixtures.py 写入的一致。

# MySQL 夹具库（smartops）
E2E_MYSQL_PASSWORD=

# mock SSH 服务器（SEC-04/05）
E2E_SSH_USER=
E2E_SSH_PASSWORD=

# 夹具账号口令
E2E_ADMIN_PASSWORD=
E2E_OPERATOR_PASSWORD=
E2E_SEC14_PASSWORD=
