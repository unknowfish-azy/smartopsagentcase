# ============================================================
# Competition Repo Hygiene (additions)
# ============================================================

# Binary / native build artifacts that must never be committed
*.exe
*.dll
*.so
*.dylib
*.bin
*.map
*.pth
*.onnx
*.gguf

# Unrelated / local-only working dirs (kept out of the public submission)
/resume-site/
/phase4-test-tmp/
/test-artifacts/

# Local build / tool caches (never commit)
/.m2/
/backend/.m2/
/.workbuddy/
/frontend/.vite-once-cache/
/frontend/components.d.ts

# 用户运行时产生的知识库数据（首次使用时生成，不入公开仓库）
/backend/data/knowledge/users/

# 本地代理工作区（Trae 等 AI agent 在仓库根下建的工作目录）
/.trae/

