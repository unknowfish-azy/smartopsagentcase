<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.smartops.mapper.ServerMetricMapper">

    <!-- =========================================================
         ServerMetricEntity 字段映射
         ========================================================= -->
    <resultMap id="MetricResultMap"
               type="com.smartops.entity.ServerMetricEntity">

        <id property="id"
            column="id"/>

        <result property="serverId"
                column="server_id"/>

        <result property="cpuUsage"
                column="cpu_usage"/>

        <result property="memoryUsage"
                column="memory_usage"/>

        <result property="diskUsage"
                column="disk_usage"/>

        <result property="networkIn"
                column="network_in"/>

        <result property="networkOut"
                column="network_out"/>

        <result property="loadAverage"
                column="load_average"/>

        <result property="status"
                column="status"/>

        <result property="collectedAt"
                column="collected_at"/>

    </resultMap>


    <!-- =========================================================
         新增监控数据
         ========================================================= -->
    <insert id="insert"
            parameterType="com.smartops.entity.ServerMetricEntity"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">

        INSERT INTO server_metric
        (
        server_id,
        cpu_usage,
        memory_usage,
        disk_usage,
        network_in,
        network_out,
        load_average,
        status,
        collected_at
        )
        VALUES
        (
        #{serverId},
        #{cpuUsage},
        #{memoryUsage},
        #{diskUsage},
        #{networkIn},
        #{networkOut},
        #{loadAverage},
        #{status},
        #{collectedAt}
        )

    </insert>


    <!-- =========================================================
         查询最新一条指标
         ========================================================= -->
    <select id="selectLatestByServerId"
            parameterType="long"
            resultMap="MetricResultMap">

        SELECT
        id,
        server_id,
        cpu_usage,
        memory_usage,
        disk_usage,
        network_in,
        network_out,
        load_average,
        status,
        collected_at
        FROM server_metric
        WHERE server_id = #{serverId}
        ORDER BY collected_at DESC
        LIMIT 1

    </select>


    <!-- =========================================================
         PERF-05：最近 N 条（点数预算由调用方传入）
         ========================================================= -->
    <select id="selectLatestListByServerId"
            resultMap="MetricResultMap">

        SELECT
        id,
        server_id,
        cpu_usage,
        memory_usage,
        disk_usage,
        network_in,
        network_out,
        load_average,
        status,
        collected_at
        FROM server_metric
        WHERE server_id = #{serverId}
        ORDER BY collected_at DESC
        LIMIT #{maxPoints}

    </select>


    <!-- =========================================================
         时间范围查询
         ========================================================= -->
    <select id="selectByTimeRange"
            resultMap="MetricResultMap">

        SELECT
        id,
        server_id,
        cpu_usage,
        memory_usage,
        disk_usage,
        network_in,
        network_out,
        load_average,
        status,
        collected_at
        FROM server_metric
        WHERE server_id = #{serverId}
        AND collected_at &gt;= #{startTime}
        AND collected_at &lt;= #{endTime}
        ORDER BY collected_at ASC

    </select>


    <!-- =========================================================
         删除某服务器全部指标
         ========================================================= -->
    <delete id="deleteByServerId"
            parameterType="long">

        DELETE FROM server_metric
        WHERE server_id = #{serverId}

    </delete>


    <!-- =========================================================
         PERF-05：按小时聚合指定日期的 avg 行（downsampling）
         H2/MySQL 兼容写法，不依赖 DATE_TRUNC
         ========================================================= -->
    <select id="selectHourlyAggregate"
            resultMap="MetricResultMap">

        SELECT
        MIN(id) AS id,
        #{serverId} AS server_id,
        AVG(cpu_usage) AS cpu_usage,
        AVG(memory_usage) AS memory_usage,
        AVG(disk_usage) AS disk_usage,
        AVG(network_in) AS network_in,
        AVG(network_out) AS network_out,
        AVG(load_average) AS load_average,
        'NORMAL' AS status,
        TIMESTAMP(DATE(collected_at),
            CAST(CONCAT(HOUR(collected_at), ':00:00') AS TIME)) AS collected_at
        FROM server_metric
        WHERE server_id = #{serverId}
          AND DATE(collected_at) = #{day}
        GROUP BY DATE(collected_at), HOUR(collected_at)
        ORDER BY collected_at ASC

    </select>


    <!-- =========================================================
         PERF-05：删除 cutoff 之前的旧指标
         ========================================================= -->
    <delete id="deleteOlderThan">

        DELETE FROM server_metric
        WHERE server_id = #{serverId}
          AND collected_at &lt; #{cutoff}

    </delete>

</mapper>
