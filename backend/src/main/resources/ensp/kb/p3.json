{
  "id": "m3",
  "order": 3,
  "code": "项目三",
  "title": "路由技术的配置",
  "objectives": [
    "掌握路由器接口、命名与基础参数配置",
    "掌握路由器远程管理（Telnet/STelnet）与 AAA 认证",
    "掌握路由器 DHCP 服务与中继配置",
    "掌握单臂路由实现 VLAN 间通信"
  ],
  "knowledgePoints": [
    {
      "id": "kp3-01", "title": "路由器工作原理与路由表", "category": "technology",
      "summary": "路由器依据目的网络查路由表转发，路由来源含直连、静态与动态。",
      "detail": "最长匹配原则选路；路由表项包含目的网段、掩码、出接口、下一跳、优先级(preference)与度量值(cost)。display ip routing-table 查看；display ip interface brief 查看接口地址状态。缺省路由 0.0.0.0/0 用于出口兜底。",
      "keyCommands": ["display ip interface brief", "display ip routing-table", "ip route-static"],
      "experiments": ["e3-01", "e3-08"], "acceptance": "能解释最长匹配并读懂路由表关键列。"
    },
    {
      "id": "kp3-02", "title": "路由器接口与子接口", "category": "command",
      "summary": "物理口可配置主 IP 与从 IP，子接口用于单臂路由终结 VLAN Tag。",
      "detail": "interface GigabitEthernet 0/0/1 配置 ip address A.B.C.D mask secondary；子接口 GigabitEthernet0/0/1.10 需 dot1q termination vid 10 后配置 IP，作为该 VLAN 网关。Serial 口需 link-protocol ppp/hdlc，DCE 端配 clock rate。",
      "keyCommands": ["interface GigabitEthernet 0/0/1", "ip address", "dot1q termination vid", "link-protocol", "clock rate"],
      "experiments": ["e3-01", "e3-08"], "acceptance": "能正确区分物理口、子接口、串口的配置差异。"
    },
    {
      "id": "kp3-03", "title": "路由器远程管理的 AAA 体系", "category": "security",
      "summary": "AAA 提供认证(Accounting/Authorization/Authentication)、授权与计费，本地认证依赖 local-user。",
      "detail": "authentication-mode aaa 时，VTY 登录校验 local-user；service-type 控制可用协议（telnet/ssh/terminal）。level 0-15 对应权限等级，15 为最高。AAA 也用于 PPP CHAP/PAP 认证场景。",
      "keyCommands": ["aaa", "local-user admin password cipher", "local-user admin service-type telnet", "authentication-mode aaa", "protocol inbound ssh"],
      "experiments": ["e3-03", "e3-04", "e3-05"], "acceptance": "能按三种认证方式完成远程登录并说明安全差异。"
    },
    {
      "id": "kp3-04", "title": "STelnet（SSH）部署要点", "category": "security",
      "summary": "SSH 基于非对称密钥协商加密通道，需生成本地密钥对、创建 SSH 用户并放行 VTY。",
      "detail": "顺序：rsa local-key-pair create → stelnet server enable → ssh user X authentication-type password → ssh user X service-type stelnet → aaa local-user → vty authentication-mode aaa + protocol inbound ssh。缺少任一步都会导致客户端连接失败。",
      "keyCommands": ["rsa local-key-pair create", "stelnet server enable", "ssh user", "ssh user authentication-type password", "protocol inbound ssh"],
      "experiments": ["e3-05"], "acceptance": "能独立排查 SSH 登录失败的常见原因。"
    },
    {
      "id": "kp3-05", "title": "路由器 DHCP 全局地址池", "category": "technology",
      "summary": "与交换机一致，路由器可在全局地址池中定义网段并供同网段或跨网段终端使用。",
      "detail": "dhcp select global 仅支持与接口同网段；跨网段须使用中继。地址池可绑定接口 dhcp select interface 使用接口地址池（gateway 自动为接口 IP）。",
      "keyCommands": ["dhcp enable", "ip pool", "network", "gateway-list", "dns-list", "expired", "dhcp select global"],
      "experiments": ["e3-06"], "acceptance": "能对比 global / interface / relay 三种模式适用场景。"
    },
    {
      "id": "kp3-06", "title": "DHCP 中继原理与配置", "category": "technology",
      "summary": "中继将客户端广播 Discover 转为单播转发给服务器，并通过 GIADDR 回传客户端网段。",
      "detail": "在靠近客户端的接口下 dhcp select relay + dhcp relay server-ip；服务器地址池按 GIADDR 所在网段分配。适用于多网段集中部署 DHCP Server 的场景。",
      "keyCommands": ["dhcp select relay", "dhcp relay server-ip", "display ip pool"],
      "experiments": ["e3-07"], "acceptance": "能通过报文字段解释中继为何能跨网段分配地址。"
    },
    {
      "id": "kp3-07", "title": "单臂路由（Router-on-a-Stick）", "category": "technology",
      "summary": "在路由器一个物理口下创建多个子接口，各自终结不同 VLAN，实现 VLAN 间路由。",
      "detail": "每个子接口 dot1q termination vid N 终结 Tag，配置 IP 作为网关；交换机侧互联口必须为 Trunk 并放行相关 VLAN。缺点是所有 VLAN 间流量共享物理带宽，易成瓶颈。",
      "keyCommands": ["interface GigabitEthernet 0/0/1.10", "dot1q termination vid 10", "arp broadcast enable", "ip address"],
      "experiments": ["e3-08"], "acceptance": "能绘制单臂路由数据流路径并指出性能瓶颈。"
    }
  ],
