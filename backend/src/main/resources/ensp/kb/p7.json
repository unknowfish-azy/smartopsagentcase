  ],
  "knowledgePoints": [
    {
      "id": "kp7-01", "title": "WLAN 标准与频段", "category": "concept",
      "summary": "WLAN 遵循 IEEE 802.11 系列，常用 2.4GHz(1-13 信道) 与 5GHz 频段。",
      "detail": "2.4G 干扰多但穿墙好；5G 速率高、信道宽但覆盖小。AP 双射频(radio 0=2.4G, radio 1=5G)可分别规划信道与功率。国家码(country-code)决定可用信道与发射功率上限。",
      "keyCommands": ["country-code cn", "channel 20mhz", "eirp"],
      "experiments": ["e7-01"], "acceptance": "能规划不干扰信道并说明双频差异。"
    },
    {
      "id": "kp7-02", "title": "Fat AP 与 Fit AP（AC+AP）", "category": "technology",
      "summary": "Fit AP 仅保留转发与射频，管理由 AC 集中完成，需建立 CAPWAP 隧道。",
      "detail": "AP 通过 DHCP Option 43 / 广播发现 AC，建立 CAPWAP 控制隧道与数据隧道；AC 下发配置、认证与漫游策略。适合中小规模集中组网；Fat AP 独立管理，适合家庭/极小规模。",
      "keyCommands": ["capwap source interface", "ap auth-mode mac-auth", "display ap all"],
      "experiments": ["e7-01", "e7-02"], "acceptance": "能描述 AP 上线的完整流程。"
    },
    {
      "id": "kp7-03", "title": "WLAN 安全机制", "category": "security",
      "summary": "安全从 WEP→WPA→WPA2 演进，企业级可用 802.1X，中小用 PSK。",
      "detail": "WPA/WPA2-PSK 使用预共享密钥 + AES/TKIP 加密；pass-phrase 长度至少 8 位；生产推荐 WPA2-AES。开放认证(open)仅用于访客，需配合 Portal/强制门户。",
      "keyCommands": ["security-profile name", "security wpa-wpa2 psk pass-phrase", "ssid-profile name"],
      "experiments": ["e7-01"], "acceptance": "能对比 PSK 与 802.1X 的部署成本与安全性。"
    },
    {
      "id": "kp7-04", "title": "VAP 模板与业务下发", "category": "command",
      "summary": "VAP（Virtual Access Point）将 SSID 模板与安全模板绑定到指定 VLAN，并下发到 AP 射频。",
      "detail": "vap-profile 中 forward-mode 可选 direct-forward(直接转发) 或 tunnel-forward(隧道转发)；service-vlan vlan-id 决定终端业务 VLAN；通过 ap-group 下 vap-profile ... radio 0/1 在对应射频生效。",
      "keyCommands": ["vap-profile name", "forward-mode direct-forward", "service-vlan vlan-id", "vap-profile wlan-net wlan 1 radio 0", "display vap ssid"],
      "experiments": ["e7-01", "e7-02"], "acceptance": "能通过 display vap/station 验证业务下发结果。"
    }
  ],
  "experiments": [
