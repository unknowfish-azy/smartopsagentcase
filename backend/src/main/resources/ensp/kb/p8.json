    {
      "id": "kp8-01", "title": "园区网分层设计（接入/汇聚/核心）", "category": "concept",
      "summary": "采用三层架构：接入层负责终端接入与 VLAN，汇聚层做策略与网关，核心层负责高速转发。",
      "detail": "接入-汇聚 Trunk 透传业务 VLAN；汇聚使用三层接口或 SVI 提供网关冗余(VRRP)；核心与出口运行动态路由或静态；出口部署 NAT/ACL。分层便于故障隔离与横向扩展。",
      "keyCommands": ["vlan batch", "port trunk allow-pass vlan", "interface Vlanif", "ip route-static"],
      "experiments": ["e8-01", "e8-03"], "acceptance": "能绘制分层拓扑并说明各层职责。"
    },
    {
      "id": "kp8-02", "title": "端到端连通性验证方法", "category": "troubleshooting",
      "summary": "自底向上：物理→链路→VLAN/Trunk→IP→路由→策略(NAT/ACL)→应用。",
      "detail": "逐段 ping/tracert 定位断点；display interface brief 看状态；display mac-address 确认学习；display ip routing-table 核对路由；display acl/nat session 排查策略误伤。",
      "keyCommands": ["ping", "tracert", "display interface brief", "display ip routing-table", "display acl all"],
      "experiments": ["e8-01", "e8-02", "e8-03"], "acceptance": "能按标准流程在 5 步内定位常见故障。"
    }
  ],
