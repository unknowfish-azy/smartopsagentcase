        { "seq": 3, "title": "R2-R3 互联", "device": "R3", "mode": "system", "hint": "R3 GE0/0/1=20.0.0.2/30", "commands": ["interface GigabitEthernet 0/0/1", "ip address 20.0.0.2 30", "undo shutdown", "quit"], "expect": "" },
        { "seq": 4, "title": "配置 R1 静态路由", "device": "R1", "mode": "system", "hint": "目的 192.168.2.0/24 经 R2", "commands": ["ip route-static 192.168.2.0 24 10.0.0.2"], "expect": "" },
        { "seq": 5, "title": "配置 R3 静态路由", "device": "R3", "mode": "system", "hint": "回程路由不可漏", "commands": ["ip route-static 192.168.1.0 24 20.0.0.1"], "expect": "" },
        { "seq": 6, "title": "端到端验证", "device": "PC1", "mode": "user", "hint": "PC1=192.168.1.2/24 gw .1; PC2=192.168.2.2/24 gw .1", "commands": ["ping 192.168.2.2"], "expect": "通。" }
