{
  "id": "m4",
  "order": 4,
  "code": "项目四",
  "title": "路由协议的配置",
  "objectives": [
    "掌握静态路由、缺省路由与浮动静态路由",
    "掌握 RIPv2 的配置、版本与汇总控制",
    "掌握 OSPF 单区域/多区域配置与 Router ID",
    "能够对比距离矢量与链路状态协议差异"
  ],
  "knowledgePoints": [
    {
      "id": "kp4-01", "title": "静态路由与最长匹配", "category": "command",
      "summary": "静态路由手工指定下一跳或出接口，preference 默认 60，用于出口与边界网络。",
      "detail": "ip route-static 目的 掩码 {下一跳 | 出接口}；广播型出接口需指定下一跳而非仅出接口。display ip routing-table 中 Proto Static。静态路由不会随拓扑变化自动收敛，需人工维护。",
      "keyCommands": ["ip route-static", "display ip routing-table"],
      "experiments": ["e4-01"], "acceptance": "能为三台路由器两两互联配置完整静态路由。"
    },
    {
      "id": "kp4-02", "title": "缺省路由与浮动静态路由", "category": "technology",
      "summary": "缺省路由 0.0.0.0/0 作为兜底；浮动静态通过调高 preference 形成备份路径。",
      "detail": "主链路 preference 60，备份 preference 80（越大越不优先）；仅当主路由失效时备份才进入路由表。适用于双出口/双链路的场景，比动态协议更简单可控。",
      "keyCommands": ["ip route-static 0.0.0.0 0.0.0.0", "preference"],
      "experiments": ["e4-02"], "acceptance": "能设计主备链路并验证切换时延与条件。"
    },
    {
      "id": "kp4-03", "title": "RIP 原理与 RIPv2 改进", "category": "technology",
      "summary": "RIP 是距离矢量协议，以跳数为度量，最大 15 跳；RIPv2 支持 VLSM 与组播更新。",
      "detail": "RIPv1 广播 255.255.255.255 且不支持 VLSM；RIPv2 组播 224.0.0.9 并携带掩码。version 2 + undo summary 才能精确发布子网；network 宣告主类网段；peer 用于 NBMA 单播。收敛慢（180s 超时），适合小型网络。",
      "keyCommands": ["rip 1", "version 2", "undo summary", "network", "peer", "display rip 1 route"],
      "experiments": ["e4-03"], "acceptance": "能解释 RIPv2 相对 v1 的四点改进。"
    },
    {
      "id": "kp4-04", "title": "OSPF 邻接关系与区域设计", "category": "technology",
      "summary": "OSPF 为链路状态协议，通过 LSA 同步 LSDB，SPF 算法计算最短路径树。",
      "detail": "Router ID 选取规则：手动 > Loopback 最大 > 物理口最大；区域 0 为骨干，非骨干须与骨干相连。邻接经历 Down/Init/2-Way/Exstart/Exchange/Loading/Full。cost=参考带宽/接口带宽。Hello 间隔与 Dead 间隔必须一致方可建邻。",
      "keyCommands": ["ospf 1 router-id", "area 0", "network", "display ospf peer brief", "display ip routing-table protocol ospf"],
      "experiments": ["e4-04"], "acceptance": "能分析邻居无法 Full 的常见原因。"
    },
    {
      "id": "kp4-05", "title": "路由引入与协议选型", "category": "troubleshooting",
      "summary": "多协议共存时需 import-route 引入；选型考虑收敛速度、规模与运维复杂度。",
      "detail": "静态适合边界/出口；RIP 适合小型扁平网络；OSPF 适合中大型分层网络。引入外部路由可能产生次优路径与环路，应配合 filter-policy / route-policy。",
      "keyCommands": ["import-route direct", "filter-policy", "display ip routing-table protocol"],
      "experiments": ["e4-03", "e4-04"], "acceptance": "能依据拓扑规模给出协议选型建议。"
    }
  ],
  "experiments": [
