{
  "id": "m2",
  "order": 2,
  "code": "项目二",
  "title": "交换技术的配置",
  "objectives": [
    "掌握交换机基本配置、远程管理与接口基础",
    "掌握 VLAN 划分与跨交换机同 VLAN 通信（Trunk）",
    "掌握三层交换机 VLANIF 实现 VLAN 间路由",
    "掌握链路聚合、生成树 STP/RSTP、DHCP、VRRP 原理与配置"
  ],
  "knowledgePoints": [
    {
      "id": "kp2-01", "title": "交换机的转发原理与 MAC 地址表", "category": "technology",
      "summary": "交换机基于目的 MAC 转发帧，通过源 MAC 学习建立 MAC 地址表，未知单播/广播/组播泛洪。",
      "detail": "MAC 表项由源 MAC 学习生成并带有老化时间（默认 300s）；display mac-address 查看。二层转发不涉及 IP，同一 VLAN 内可通信，跨 VLAN 必须借助三层设备或三层交换机的 VLANIF。",
      "keyCommands": ["display mac-address", "mac-address aging-time"],
      "experiments": ["e2-05"], "acceptance": "能解释帧转发/泛洪行为并会用 display mac-address 验证。"
    },
    {
      "id": "kp2-02", "title": "VLAN 的概念与划分方法", "category": "concept",
      "summary": "VLAN 在二层隔离广播域，划分方式有基于端口、MAC、协议、子网等，工程以基于端口为主。",
      "detail": "Access 口用于连接终端，只属于一个 VLAN；Trunk 口用于交换机互联，允许多个 VLAN 通过并携带 Tag；Hybrid 口可同时收发带/不带 Tag 的帧。VLAN 1 为默认 VLAN，不可删除，建议业务使用 VLAN 10 起。",
      "keyCommands": ["vlan batch", "port link-type access", "port default vlan"],
      "experiments": ["e2-05"], "acceptance": "能区分 Access/Trunk/Hybrid 的应用场景。"
    },
    {
      "id": "kp2-03", "title": "Trunk 链路负载与 PVID", "category": "command",
      "summary": "Trunk 口需放行相应 VLAN，默认 PVID 为 VLAN 1，收无 Tag 帧归入 PVID。",
      "detail": "port trunk allow-pass vlan 控制允许的 VLAN；port trunk pvid vlan 修改默认 VLAN。不同厂商 Trunk 封装不同（华为 802.1Q，思科 ISL），互联需一致。",
      "keyCommands": ["port link-type trunk", "port trunk allow-pass vlan", "port trunk pvid vlan"],
      "experiments": ["e2-06"], "acceptance": "能配置跨交换机同 VLAN 通信并说明 Tag 处理过程。"
    },
    {
      "id": "kp2-04", "title": "三层交换机与 VLAN 间路由", "category": "technology",
      "summary": "三层交换机通过 SVI（VLANIF）实现 VLAN 间路由，转发性能高于单臂路由。",
      "detail": "每个 VLAN 对应一个 VLANIF 逻辑接口，配置 IP 作为该 VLAN 网关；启用 ip routing 后（部分型号默认）即可进行三层转发。单臂路由则是在路由器物理口下创建子接口 dot1q termination vid，适合小型网络。",
      "keyCommands": ["interface Vlanif 10", "ip address", "display ip interface brief"],
      "experiments": ["e2-07", "e3-07"], "acceptance": "能对比三层交换与单臂路由两种跨 VLAN 方案。"
    },
    {
      "id": "kp2-05", "title": "链路聚合 Eth-Trunk", "category": "technology",
      "summary": "将多条物理链路捆绑为一条逻辑链路，提升带宽与可靠性，分为静态 LACP 与手工模式。",
      "detail": "LACP（802.3ad）通过 LACPDU 协商活动成员口；手工模式需两端手动一致。活动链路数上限 max active-linknumber 控制参与转发的端口数量，其余备份。负载分担模式按源/目 MAC/IP 哈希。",
      "keyCommands": ["interface Eth-Trunk 1", "eth-trunk 1", "mode lacp-static", "least active-linknumber", "load-balance"],
      "experiments": ["e2-08"], "acceptance": "能配置 LACP 聚合并通过 display eth-trunk 判断成员状态。"
    },
    {
      "id": "kp2-06", "title": "生成树 STP/RSTP 原理", "category": "technology",
      "summary": "生成树通过选举根桥、计算最短路径、阻塞冗余端口来消除二层环路并提供链路备份。",
      "detail": "BPDU 携带 Bridge ID（优先级+MAC）；根桥选优先级最小者；非根桥选根端口（到根路径开销最小）；每条链路选指定端口，其余阻塞。RSTP 引入替代/备份端口与边缘端口，收敛时间从 30s 级降至秒级。stp root primary 自动将优先级置 0。",
      "keyCommands": ["stp mode rstp", "stp root primary", "stp priority", "stp edged-port enable", "display stp brief"],
      "experiments": ["e2-09", "e2-10"], "acceptance": "能分析 BPDU 选举结果并用 display stp 定位根桥/阻塞口。"
    },
    {
      "id": "kp2-07", "title": "交换机 DHCP 服务与中继", "category": "technology",
      "summary": "DHCP 全局使能后可采用全局地址池或接口地址池方式分配地址，跨网段用中继。",
      "detail": "dhcp select global 在接口引用 ip pool；dhcp select relay + dhcp relay server-ip 指向服务器。地址池要素：network、gateway-list、dns-list、expired。中继依赖 GIADDR 字段回传客户端网段。",
      "keyCommands": ["dhcp enable", "ip pool", "network", "gateway-list", "dns-list", "expired", "dhcp select global", "dhcp relay server-ip"],
      "experiments": ["e2-11", "e3-06"], "acceptance": "能为多 VLAN 配置 DHCP 并说明报文交互四步。"
    },
    {
      "id": "kp2-08", "title": "VRRP 网关冗余", "category": "security",
      "summary": "VRRP 将多个设备虚拟为一个网关，Master 转发、Backup 热备，避免单点故障。",
      "detail": "备份组由 vrid 标识，virtual-ip 作为网关；优先级默认 100，Master 需大于 Backup；支持抢占与上行链路跟踪（track 上行口 down 时降低优先级触发切换）。VRRP 报文组播 224.0.0.18。",
      "keyCommands": ["vrrp vrid 1 virtual-ip", "vrrp vrid 1 priority", "vrrp vrid 1 preempt-mode timer delay", "vrrp vrid 1 track interface", "display vrrp brief"],
      "experiments": ["e2-12"], "acceptance": "能配置主备网关并模拟 Master 故障观察倒换。"
    }
  ],
