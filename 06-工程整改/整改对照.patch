+"""Evaluate frozen synthetic cases. Labels never enter the inspector context."""
+from __future__ import annotations
+import argparse
+import csv
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT))
+from agent.inspector.pipeline import InspectorPipeline
+from agent.inspector.models import EvidenceItem
+
+FIXTURE = REPO_ROOT / 'tests/fixtures/defense/false_success.json'
+DEFAULT_OUTPUT = REPO_ROOT / '06-工程整改/eval_false_success.csv'
+
+
+def load_cases(path=FIXTURE):
+    return json.loads(Path(path).read_text(encoding='utf-8'))['cases']
+
+
+def predict(case, pipeline):
+    # Only facts and the claim enter prediction. Labels remain outside.
+    probes = case['probes']
+    return pipeline.run({
+        'task_id': case['id'], 'target': 'SERVICE', 'agent_claim': case['claim'],
+        'actual_state': {'probes': probes},
+        'evidence': [EvidenceItem(content=json.dumps(probes, ensure_ascii=False), source='synthetic fixture')],
+    })
+
+
+def evaluate(cases=None):
+    cases = load_cases() if cases is None else cases
+    pipeline = InspectorPipeline()
+    rows = []
+    for case in cases:
+        result = predict(case, pipeline)
+        verification = result.verification_result or {}
+        unknown = verification.get('checked') is not True
+        detected = bool(verification.get('false_success'))
+        rows.append({
+            'sample_id': case['id'], 'category': case['category'],
+            'claim': case['claim'], 'probe_shape': json.dumps(case['probes'], ensure_ascii=False),
+            'expected_false_success': case['expected_false_success'],
+            'detected_false_success': detected, 'unverifiable': unknown,
+            'inspection_status': result.status.value, 'reason': verification.get('reason'),
+            'label_reason': case['label_reason'],
+        })
+    scored = [row for row in rows if row['expected_false_success'] is not None]
+    tp = sum(row['expected_false_success'] is True and row['detected_false_success'] for row in scored)
+    tn = sum(row['expected_false_success'] is False and not row['detected_false_success'] for row in scored)
+    fp = sum(row['expected_false_success'] is False and row['detected_false_success'] for row in scored)
+    fn = sum(row['expected_false_success'] is True and not row['detected_false_success'] for row in scored)
+    precision = tp / (tp + fp) if tp + fp else 0.0
+    recall = tp / (tp + fn) if tp + fn else 0.0
+    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0
+    return rows, dict(n=len(rows), scored_n=len(scored), unscored_n=len(rows)-len(scored),
+                      TP=tp, TN=tn, FP=fp, FN=fn, precision=precision, recall=recall, F1=f1)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, default=DEFAULT_OUTPUT)
+    args = parser.parse_args()
+    rows, metrics = evaluate()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open('w', encoding='utf-8-sig', newline='') as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    print(json.dumps(metrics, ensure_ascii=False))
+    print('fixture_sha256=' + hashlib.sha256(FIXTURE.read_bytes()).hexdigest())
+    print('合成样本仅验证链路；L3默认passthrough；未知观测不计入二分类分母；不以目标F1筛选样本。')
+    print(f'CSV: {args.output}')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
