{
  "name": "smartops-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.admin.mjs",
    "knowledge:export": "node ../scripts/knowledge/export-catalog.mjs",
    "knowledge:check": "node ../scripts/knowledge/export-catalog.mjs --check",
    "prebuild": "npm run knowledge:check",
    "build": "vite build",
    "build:admin": "vite build --config vite.config.admin.mjs",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.config.admin.mjs --port 5174",
    "test": "node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 31",
    "visual-check": "node test/visual-check.mjs",
    "personal-navigation-check": "node test/personal-navigation-visual-check.mjs",
    "test:visual": "node test/visual-suite.mjs",
    "perf:baseline": "node test/performance-baseline.browser.mjs",
    "test:a11y": "node test/accessibility.browser.mjs"
  },
  "dependencies": {
    "@guochenwang/lggc": "^1.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.0.0",
    "echarts": "^5.0.0",
    "element-plus": "^2.0.0",
    "pinia": "^3.0.0",
    "three": "^0.186.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^15.15.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0"
  }
}
