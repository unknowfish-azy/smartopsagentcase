{
  "name": "smartops-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.admin.mjs",
    "dev:enterprise": "vite --config vite.config.enterprise.mjs",
    "dev:audit": "vite --config vite.config.audit.mjs",
    "dev:command": "vite --config vite.config.command.mjs",
    "dev:open": "vite --config vite.config.open.mjs",
    "knowledge:export": "node ../scripts/knowledge/export-catalog.mjs",
    "knowledge:check": "node ../scripts/knowledge/export-catalog.mjs --check",
    "atlas:distill": "node ../scripts/atlas/distill-atlas.mjs",
    "atlas:section-refs": "node ../scripts/atlas/section-refs.mjs",
    "prebuild": "npm run knowledge:check",
    "build": "vite build",
    "build:admin": "vite build --config vite.config.admin.mjs",
    "build:enterprise": "vite build --config vite.config.enterprise.mjs",
    "build:audit": "vite build --config vite.config.audit.mjs",
    "build:command": "vite build --config vite.config.command.mjs",
    "build:open": "vite build --config vite.config.open.mjs",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.config.admin.mjs --port 5174",
    "preview:enterprise": "vite preview --config vite.config.enterprise.mjs --port 5175",
    "preview:audit": "vite preview --config vite.config.audit.mjs --port 5176",
    "preview:command": "vite preview --config vite.config.command.mjs --port 5177",
    "preview:open": "vite preview --config vite.config.open.mjs --port 5178",
    "test": "node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint . --max-warnings 31",
    "visual-check": "node test/visual-check.mjs",
    "personal-navigation-check": "node test/personal-navigation-visual-check.mjs",
    "test:visual": "node test/visual-suite.mjs",
    "perf:baseline": "node test/performance-baseline.browser.mjs",
    "persona:device": "node test/persona-device-acceptance.mjs",
    "test:a11y": "node test/accessibility.browser.mjs"
  },
  "dependencies": {
    "@guochenwang/lggc": "^1.0.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.0.0",
    "echarts": "^5.0.0",
    "element-plus": "^2.0.0",
    "pinia": "^3.0.0",
    "three": "^0.186.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^15.15.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.14"
  }
}
